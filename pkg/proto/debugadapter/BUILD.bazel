load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "debugadapter_proto",
    srcs = ["debugadapter.proto"],
    import_prefix = "github.com/buildbarn/bb-remote-execution",
    visibility = ["//visibility:public"],
    deps = ["@protobuf//:empty_proto"],
)

go_proto_library(
    name = "debugadapter_go_proto",
    compilers = [
        "@rules_go//proto:go_proto",
        "@rules_go//proto:go_grpc_v2",
    ],
    importpath = "github.com/buildbarn/bb-remote-execution/pkg/proto/debugadapter",
    proto = ":debugadapter_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "debugadapter",
    embed = [":debugadapter_go_proto"],
    importpath = "github.com/buildbarn/bb-remote-execution/pkg/proto/debugadapter",
    visibility = ["//visibility:public"],
)
